{
  "version": 2,
  "regions": ["iad1"],
  "redirects": [
    { "source": "/press", "destination": "/", "permanent": true },
    { "source": "/blog/distilled-water-reverse-osmosis", "destination": "/blog/reverse-osmosis-vs-distilled-water", "permanent": true },
    {
      "source": "/",
      "has": [{ "type": "host", "value": "www.watercheckup.com" }],
      "destination": "https://watercheckup.com/",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.watercheckup.com" }],
      "destination": "https://watercheckup.com/:path*",
      "permanent": true
    }
  ],
  "crons": [
    {
      "path": "/api/newsletter/weekly",
      "schedule": "0 14 * * 1"
    }
  ]
}
