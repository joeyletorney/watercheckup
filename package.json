{
  "name": "watercheckup",
  "version": "1.0.0",
  "engines": {
    "node": ">=18.17.0"
  },
  "scripts": {
    "dev": "next dev -p 3000",
    "dev:poll": "WATCHPACK_POLLING=true next dev -p 3000",
    "clean": "rm -rf .next",
    "dev:clean": "npm run clean && next dev -p 3000",
    "build-utility-indexes": "tsx scripts/build-utility-indexes.ts",
    "build": "npm run build-utility-indexes && next build",
    "start": "next start",
    "fetch-utilities": "tsx scripts/fetch-utilities.ts",
    "build-pwsid-ccr-contaminants": "tsx scripts/build-pwsid-ccr-contaminants.ts --limit 500"
  },
  "dependencies": {
    "babel-plugin-react-compiler": "^1.0.0",
    "critters": "^0.0.23",
    "next": "16.2.7",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "recharts": "^2.12.7",
    "resend": "^3.2.0"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "19.2.17",
    "autoprefixer": "^10.5.0",
    "csv-parse": "^6.2.1",
    "eslint": "^9",
    "eslint-config-next": "16.2.7",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.19.2",
    "typescript": "^5"
  },
  "overrides": {
    "@types/react": "19.2.17"
  }
}
